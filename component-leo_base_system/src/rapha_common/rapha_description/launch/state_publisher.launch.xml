<launch version="0.1.1">
  <arg
    name="model"
    default="$(find-pkg-share rapha_description)/urdf/rapha.urdf.xacro"
    description="Absolute path to robot urdf.xacro file" />

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var model)')" />
    <!-- The base controller's wheel/servo states are bridged up under the
         /controller prefix (see docker-compose controller_relay BRIDGE_TOPICS),
         so subscribe there instead of the default /joint_states. -->
    <remap from="joint_states" to="/controller/joint_states" />
  </node>
</launch>
